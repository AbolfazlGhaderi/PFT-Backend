{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],

      "@app/*": [ "./src/app/*" ],
      "@plugins": [ "./src/app/plugins/index.ts" ],
      "@plugins/*": [ "./src/app/plugins/*" ],
      "@utils": ["./src/app/utils/index.ts"],
      "@helpers": ["./src/app/helpers/index.ts"],
      "@interceptors": ["./src/app/interceptors/index.ts"],
      "@middlewares": ["./src/app/middlewares/index.ts"],
      "@common/*": [ "./src/common/*" ],
      "@enums": [ "./src/common/enums/index.ts" ],
      "@constants": [ "./src/common/constants/index.ts" ],
      "@DTOs": [ "./src/common/dtos/index.ts" ],

      "@configs": [ "./src/configs/index.ts" ],
      "@configs/*": [ "./src/configs/*" ],


      "@types": ["./src/common/types/index.ts"],
    }
  }
}
