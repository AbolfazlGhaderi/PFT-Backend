{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": [ "./src/app/*" ],
      "@plugins": [ "./src/app/plugins/index.js" ],
      "@plugins/*": [ "./src/app/plugins/*" ],
      "@common/*": [ "./src/common/*" ],
      "@configs": [ "./src/configs/index.js" ],
      "@configs/*": [ "./src/configs/*" ],
      "@types": ["./src/common/types.ts"],
    }
  }
}
