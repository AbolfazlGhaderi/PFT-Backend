{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],

      "@app/*": [ "./src/app/*" ],
      "@plugins": [ "./src/app/plugins/index.ts" ],
      "@plugins/*": [ "./src/app/plugins/*" ],
      "@utils": ["./src/app/utils/index.ts"],
      "@helpers": ["./src/app/helpers/index.ts"],
      "@interceptors": ["./src/app/interceptors/index.ts"],
      "@middlewares": ["./src/app/middlewares/index.ts"],
      "@exceptionsFilters": ["./src/app/exception-filters/index.ts"],
      "@pipes": ["./src/app/pipes/index.ts"],
      
      "@database": ["./src/app/database/index.ts"],
      "@database/*": ["./src/app/database/*"],
      "@db-entities": ["./src/app/database/entities/index.ts"],
      "@db-entities/*": ["./src/app/database/entities/*"],
      "@db-repositories": ["./src/app/database/repositories/index.ts"],
      "@db-repositories/*": ["./src/app/database/repositories/*"],
      
      "@common/*": [ "./src/common/*" ],
      "@enums": [ "./src/common/enums/index.ts" ],
      "@constants": [ "./src/common/constants/index.ts" ],
      "@DTOs": [ "./src/common/dtos/index.ts" ],
      "@decorators": [ "./src/common/decorators/index.ts" ],
      "@configs": [ "./src/configs/index.ts" ],
      "@configs/*": [ "./src/configs/*" ],


      "@types": ["./src/common/types/index.ts"],
    }
  }
}
