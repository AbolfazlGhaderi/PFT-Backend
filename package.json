{
  "name": "project-name",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src/",
    "prelint": "pnpm format",
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "mig:create": "mikro-orm migration:create --config dist/configs/mikro-orm-migration.config.js",
    "mig:up": "mikro-orm migration:up --config dist/configs/mikro-orm-migration.config.js"
  },  
  "dependencies": {
    "@mikro-orm/cli": "^7.2.8",
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/decorators": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.8",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/nestjs-api-reference": "^1.2.37",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "logger-nestjs": "^0.0.6",
    "nestjs-cls": "^7.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
